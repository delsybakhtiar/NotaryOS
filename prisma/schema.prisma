// ============================================
// NOTARYOS - SISTEM ADMINISTRASI KANTOR NOTARIS
// Database Schema - Prisma ORM
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN           // Notaris - Full access
  STAFF           // Staff Operasional - Limited access
  FINANCE         // Finance - Access to financial data only
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  APPROVE
  REJECT
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String   // Hashed password (bcrypt)
  role      UserRole @default(STAFF)
  
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  accounts       Account[]
  sessions       Session[]
  auditLogs      AuditLog[]
  documents      Document[]
  clients        Client[]
  invoices       Invoice[]
  notifications  Notification[]
  
  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// AUDIT LOGGING (CRITICAL FOR COMPLIANCE)
// ============================================

model AuditLog {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  
  action      AuditAction
  status      AuditStatus  @default(SUCCESS)
  
  // Target entity (what was changed)
  entityType  String       // e.g., "Client", "Document", "Invoice"
  entityId    String?      // ID of the entity that was changed
  
  // Data for tracking changes
  oldValue    String?      // JSON string of old value
  newValue    String?      // JSON string of new value
  
  // Request context
  ipAddress   String?
  userAgent   String?
  
  // Additional context
  description String?      // Human-readable description
  metadata    String?      // JSON string for additional context
  
  timestamp   DateTime     @default(now())
  
  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@index([action])
}

// ============================================
// CLIENT MANAGEMENT (CRM & KYC)
// ============================================

enum ClientType {
  INDIVIDUAL
  CORPORATE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Client {
  id              String       @id @default(cuid())

  // Basic info
  clientCode      String       @unique // e.g., "CLI-2024-0001"
  clientType      ClientType
  status          ClientStatus @default(ACTIVE)

  // Name (unified for individual and corporate)
  name            String       // Full name for individual, company name for corporate

  // Individual fields
  firstName       String?
  lastName        String?
  nik             String?      @unique // Nomor Induk Kependudukan
  dateOfBirth     DateTime?
  placeOfBirth    String?

  // Corporate fields
  npwp            String?      @unique
  companyType     String?      // e.g., "PT", "CV", "Firma"

  // Contact info
  email           String?
  phone           String?
  address         String?
  city            String?
  province        String?
  postalCode      String?

  // KYC & Documents
  kycStatus       KycStatus    @default(PENDING)
  kycVerifiedAt   DateTime?
  kycVerifiedBy   String?      // User ID
  kycRejectNotes  String?      // Notes for rejection reason
  ktpUrl          String?      // KTP document path (for individual)
  npwpUrl         String?      // NPWP document path (for individual/corporate)

  // QR/Barcode for physical-digital bridge
  qrCode          String       @unique // Generated unique QR code

  // UU PDP Compliance
  dataConsentGiven Boolean  @default(false)  // Persetujuan pengolahan data (Pasal 7)
  dataConsentGivenAt DateTime?  // Waktu persetujuan diberikan
  dataConsentExpiresAt DateTime?  // Waktu persetujuan berakhir
  canContactForMarketing Boolean @default(false)  // Persetujuan untuk marketing

  // Metadata
  notes           String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  createdBy       User?         @relation(fields: [createdByUserId], references: [id])
  createdByUserId String?

  documents       Document[]
  dataSubjectRequests  DataSubjectRequest[]  // Permintaan dari subjek data (Pasal 26)

  @@index([clientCode])
  @@index([clientType])
  @@index([status])
  @@index([kycStatus])
  @@index([nik])
  @@index([npwp])
  @@index([qrCode])
  @@index([createdByUserId])
  @@index([dataConsentGiven])
}

// ============================================
// DOCUMENT MANAGEMENT (AKTA)
// ============================================

enum DocumentStatus {
  DRAFT
  REVIEW
  SIGNING
  ARCHIVED
}

enum DocumentType {
  AKTA_PENDIRIAN
  AKTA_PERUBAHAN
  AKTA_PEMBERIAN_HAK_TANGGUNGAN
  AKTA_WARIS
  SURAT_KUASA
  PERJANJIAN
  LAINNYA
}

model Document {
  id              String         @id @default(cuid())
  
  // Basic info
  documentNumber  String         @unique // e.g., "AKTA-2024-0001"
  documentType    DocumentType
  status          DocumentStatus @default(DRAFT)
  
  // Title & content
  title           String
  description     String?
  content         String?        // Rich text content
  
  // QR/Barcode for physical-digital bridge
  qrCode          String         @unique // Links to physical document
  
  // Dates
  documentDate    DateTime?      // Tanggal akta dibuat
  effectiveDate   DateTime?      // Tanggal akta berlaku
  
  // Participants
  parties         String?        // JSON array of parties involved
  
  // Metadata
  notes           String?
  tags            String?        // JSON array of tags
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Relations
  clientId        String?
  client          Client?         @relation(fields: [clientId], references: [id])
  
  createdBy       User?           @relation(fields: [createdByUserId], references: [id])
  createdByUserId String?
  
  reviewedBy      String?        // User ID
  reviewedAt      DateTime?
  
  signedBy        String?        // User ID (Notaris)
  signedAt        DateTime?
  
  versions        DocumentVersion[]
  
  @@index([documentNumber])
  @@index([documentType])
  @@index([status])
  @@index([clientId])
  @@index([qrCode])
  @@index([documentDate])
  @@index([createdByUserId])
}

// Version control for documents (Auditability)
model DocumentVersion {
  id          String   @id @default(cuid())
  
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  version     Int
  content     String
  changeNotes String?
  
  createdBy   String
  createdAt   DateTime @default(now())
  
  @@unique([documentId, version])
  @@index([documentId])
}

// ============================================
// FINANCIAL MANAGEMENT
// ============================================

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHEQUE
  QRIS
  EWALLET
}

model Invoice {
  id              String         @id @default(cuid())
  
  invoiceNumber   String         @unique // e.g., "INV-2024-0001"
  
  // Amount
  subtotal        Float
  taxRate         Float          @default(11) // PPN 11%
  taxAmount       Float
  discount        Float          @default(0)
  total           Float
  
  // Status
  status          InvoiceStatus  @default(DRAFT)
  paidAmount      Float          @default(0)
  remainingAmount Float
  
  // Dates
  issueDate       DateTime       @default(now())
  dueDate         DateTime
  paidDate        DateTime?
  
  // Related entities
  clientId        String?
  documentId      String?
  
  // Description
  description     String?
  notes           String?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  // Relations
  createdBy       User?           @relation(fields: [createdByUserId], references: [id])
  createdByUserId String?
  
  payments        Payment[]
  
  @@index([invoiceNumber])
  @@index([status])
  @@index([clientId])
  @@index([documentId])
  @@index([dueDate])
  @@index([createdByUserId])
}

model Payment {
  id              String        @id @default(cuid())
  
  paymentNumber   String        @unique // e.g., "PAY-2024-0001"
  
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  
  amount          Float
  paymentMethod   PaymentMethod
  
  // Bank/transaction info
  bankName        String?
  accountNumber   String?
  accountName     String?
  transactionRef  String?
  
  // Attachment (proof of payment)
  attachmentPath  String?
  
  notes           String?
  
  paidAt          DateTime      @default(now())
  createdAt       DateTime      @default(now())
  
  @@index([paymentNumber])
  @@index([invoiceId])
  @@index([paidAt])
}

// ============================================
// NOTIFICATION SYSTEM
// ============================================

enum NotificationType {
  KYC_STATUS_CHANGE
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  INVOICE_CREATED
  PAYMENT_RECEIVED
  SYSTEM_ALERT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model Notification {
  id          String             @id @default(cuid())
  
  userId      String             // User who receives the notification
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        NotificationType
  status      NotificationStatus @default(UNREAD)
  
  title       String             // Short title (e.g., "KYC Disetujui")
  message     String             // Full message
  
  metadata    String?            // JSON string for additional data
  actionUrl   String?            // URL to navigate when clicked
  
  readAt      DateTime?
  
  createdAt   DateTime           @default(now())
  
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// NOTARIS SETTINGS
// ============================================

model NotarisSettings {
  id          String   @id @default(cuid())

  // Kantor Notaris Info
  officeName  String   // Nama Kantor Notaris
  officeAddress String  // Alamat lengkap
  city        String   // Kota
  province    String   // Provinsi
  postalCode  String   // Kode pos
  phone       String   // Nomor telepon
  email       String   // Email resmi
  website     String?  // Website (opsional)

  // Info Notaris
  notarisName String   // Nama Notaris
  notarisNumber String? // Nomor SK Notaris
  notarisRegion String? // Wilayah kerja notaris

  // Dokumen Settings
  documentPrefix String @default("AKTA") // Prefix nomor dokumen
  invoicePrefix  String @default("INV")  // Prefix nomor invoice

  // UU PDP Compliance Settings
  privacyPolicy   String?   // Kebijakan privasi kantor notaris
  dataRetentionYears Int @default(10)  // Retensi data klien dalam tahun (sesuai aturan notaris)
  auditLogRetentionMonths Int @default(6)  // Retensi audit log minimum 6 bulan (Pasal 31 UU PDP)
  dpoEmail       String?   // Email Data Protection Officer
  dpoName        String?   // Nama Data Protection Officer

  // Metadata
  logoUrl    String?  // URL logo kantor
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([province])
}

// ============================================
// DATA SUBJECT REQUESTS (UU PDP - Pasal 26)
// ============================================

enum DataSubjectRequestType {
  ACCESS      // Hak untuk mendapatkan akses atas Data Pribadi
  CORRECTION  // Hak untuk meminta koreksi Data Pribadi
  DELETION    // Hak untuk meminta penghapusan Data Pribadi
  RESTRICTION // Hak untuk meminta pembatasan pemrosesan
  OBJECTION  // Hak untuk menolak pemrosesan
  PORTABILITY // Hak untuk meminta pemindahan Data Pribadi
}

enum DataSubjectRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model DataSubjectRequest {
  id          String                    @id @default(cuid())

  client      Client                    @relation(fields: [clientId], references: [id])
  clientId    String

  requestType DataSubjectRequestType
  status      DataSubjectRequestStatus  @default(PENDING)

  reason      String?                   // Alasan permintaan
  description String?                   // Deskripsi detail permintaan

  processedBy String?                   // User ID yang memproses
  processedAt DateTime?                 // Waktu diproses
  rejectionReason String?               // Alasan penolakan

  metadata    String?                   // JSON string untuk data tambahan

  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([clientId])
  @@index([requestType])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// DATA BREACH NOTIFICATION (UU PDP - Pasal 34)
// ============================================

enum DataBreachSeverity {
  LOW       // Dampak minimal
  MEDIUM    // Dampak sedang
  HIGH      // Dampak tinggi
  CRITICAL  // Dampak kritis
}

enum DataBreachStatus {
  DETECTED      // Terdeteksi
  INVESTIGATING // Sedang diselidiki
  CONTAINED     // Telah dikendalikan
  RESOLVED      // Telah diselesaikan
  NOTIFIED      // Telah diberitahu
}

model DataBreach {
  id          String             @id @default(cuid())

  title       String             // Judul insiden
  description String             // Deskripsi detail

  severity    DataBreachSeverity
  status      DataBreachStatus   @default(DETECTED)

  // Data yang terdampak
  affectedDataTypes String?      // JSON string of data types (e.g., ["NIK", "email"])
  affectedClientIds String?      // JSON string of client IDs affected
  estimatedAffectedCount Int     @default(0)  // Perkiraan jumlah klien terdampak

  // Timeline
  detectedAt  DateTime           // Waktu deteksi
  occurredAt  DateTime?          // Perkiraan waktu kejadian
  containedAt DateTime?          // Waktu dikendalikan
  resolvedAt  DateTime?          // Waktu diselesaikan

  // Notifikasi
  notifiedAt  DateTime?          // Waktu notifikasi dikirim
  notifiedTo  String?            // JSON string pihak yang dinotifikasi (e.g., ["clients", "OJK", "Kominfo"])
  notificationMethod String?     // Cara notifikasi (email, surat, dll)

  // Investigasi
  rootCause   String?            // Penyebab utama
  correctiveActions String?      // JSON string tindakan korektif
  preventiveActions String?      // JSON string tindakan pencegahan

  // Metadata
  reportedBy  String?            // User ID yang melaporkan
  notes       String?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([severity])
  @@index([status])
  @@index([detectedAt])
  @@index([createdAt])
}