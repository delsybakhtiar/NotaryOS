# ============================================
# NOTARYOS - STAGING ENVIRONMENT
# Use this for testing before production
# ============================================

# DATABASE (Supabase Staging Project)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[STAGING-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
NEXT_PUBLIC_SUPABASE_URL="https://[STAGING-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[STAGING-SERVICE-ROLE-KEY]"

# NEXTAUTH
NEXTAUTH_URL="https://staging.yourdomain.com"
NEXTAUTH_SECRET="[generate-with-openssl-rand-base64-32]"

# APP CONFIGURATION
NODE_ENV="staging"
APP_URL="https://staging.yourdomain.com"
APP_NAME="NotaryOS (Staging)"

# SECURITY
RATE_LIMIT_MAX_REQUESTS="1000"  # More lenient for testing
RATE_LIMIT_WINDOW_MS="900000"

# MONITORING
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# FEATURES
ENABLE_REGISTRATION="true"  # Allow registration for testing
ENABLE_2FA="false"
ENABLE_AUDIT_EXPORT="true"