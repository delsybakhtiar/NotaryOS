# ============================================
# NOTARYOS - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development
# NEVER commit this file to version control
# ============================================

# ============================================
# DATABASE (Supabase Production)
# ============================================
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Supabase Service Role Key (Server-side only - NEVER expose to client)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ============================================
# NEXTAUTH (Authentication)
# ============================================
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="[generate-with-openssl-rand-base64-32]"

# ============================================
# APP CONFIGURATION
# ============================================
NODE_ENV="production"
APP_URL="https://yourdomain.com"
APP_NAME="NotaryOS"

# ============================================
# SECURITY
# ============================================
# Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes

# Session configuration
SESSION_MAX_AGE="604800000"  # 7 days
SESSION_UPDATE_AGE="86400000"  # 1 day

# ============================================
# MONITORING & LOGGING (Optional)
# ============================================
# Sentry for error tracking
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=""

# ============================================
# BACKUP & MAINTENANCE (Server-side only)
# ============================================
# Database backup retention days
BACKUP_RETENTION_DAYS="90"

# Email notifications (optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@yourdomain.com"

# ============================================
# SECURITY KEYS (Generate with OpenSSL)
# ============================================
# Run: openssl rand -base64 32
ENCRYPTION_KEY=""

# Run: openssl rand -base64 16
CSRF_SECRET=""

# ============================================
# FEATURES FLAGS
# ============================================
ENABLE_REGISTRATION="false"  # Disable self-registration for security
ENABLE_2FA="false"  # Two-factor authentication (future feature)
ENABLE_AUDIT_EXPORT="true"  # Allow audit log export